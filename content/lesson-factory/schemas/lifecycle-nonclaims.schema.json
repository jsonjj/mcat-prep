{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcat-mastery.internal/lesson-factory/schemas/v1/lifecycle-nonclaims.schema.json",
  "x_contract_id": "lesson-factory.lifecycle-nonclaims",
  "x_contract_version": "2.0.0",
  "title": "Candidate lifecycle and nonclaims",
  "description": "The candidate lifecycle states, their transitions, and the exhaustive list of things CANDIDATE_RUBRIC_SCREENED never asserts. A lifecycle value records where a draft sits in a workflow; it is not a rubric verdict.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "contract_version",
    "screened_status",
    "status_kind",
    "lifecycle_states",
    "transitions",
    "never_asserts",
    "separation",
    "nonclaims"
  ],
  "properties": {
    "contract_id": {
      "const": "lesson-factory.lifecycle-nonclaims"
    },
    "contract_version": {
      "const": "2.0.0",
      "description": "The one contract version this schema describes. An instance that claims another version was validated against a contract that is not this one."
    },
    "screened_status": {
      "const": "CANDIDATE_RUBRIC_SCREENED"
    },
    "status_kind": {
      "const": "LIFECYCLE_ONLY"
    },
    "lifecycle_states": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "$ref": "shared-vocabulary.schema.json#/$defs/LifecycleState"
      }
    },
    "transitions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "requires"],
        "properties": {
          "from": {
            "$ref": "shared-vocabulary.schema.json#/$defs/LifecycleState"
          },
          "to": {
            "$ref": "shared-vocabulary.schema.json#/$defs/LifecycleState"
          },
          "requires": {
            "$ref": "shared-vocabulary.schema.json#/$defs/NonEmptyString"
          }
        }
      }
    },
    "never_asserts": {
      "type": "array",
      "minItems": 9,
      "uniqueItems": true,
      "items": {
        "$ref": "shared-vocabulary.schema.json#/$defs/NonEmptyString"
      }
    },
    "separation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["author_diagnostics_namespace", "official_quality_namespace", "separation_rule"],
      "properties": {
        "author_diagnostics_namespace": {
          "const": "author_diagnostics"
        },
        "official_quality_namespace": {
          "const": "official_quality_result"
        },
        "separation_rule": {
          "$ref": "shared-vocabulary.schema.json#/$defs/NonEmptyString"
        }
      }
    },
    "nonclaims": {
      "$ref": "shared-vocabulary.schema.json#/$defs/Nonclaims"
    }
  }
}

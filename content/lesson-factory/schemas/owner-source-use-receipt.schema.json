{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcat-mastery.internal/lesson-factory/schemas/v1/owner-source-use-receipt.schema.json",
  "x_contract_id": "lesson-factory.owner-source-use-receipt",
  "x_contract_version": "2.0.0",
  "title": "Owner source-use receipt",
  "description": "One human decision, recorded once, about which uses of which sources are permitted while authoring deadline candidates. Version 1 decided by source class, which meant a packet had to work out which class a source belonged to before it could apply the decision — and every way of working that out from an identifier is a guess about a string. Version 2 decides per source id: thirteen rows, each naming the class, the uses, the derived fields, and the evidence the class rests on. A source id absent from this table is not decided, and an undecided source cannot be used. The receipt does not clear anybody else’s rights, does not license anything, and does not approve a lesson.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "contract_version",
    "receipt_id",
    "decided_at",
    "decision_role",
    "decision_scope",
    "source_decisions",
    "undecided_source_disposition",
    "source_classes",
    "permitted_use_codes",
    "prohibited_use_codes",
    "derived_field_allowlist",
    "statement_ref",
    "human_statement_authoritative",
    "nonclaims"
  ],
  "properties": {
    "contract_id": {
      "const": "lesson-factory.owner-source-use-receipt"
    },
    "contract_version": {
      "const": "2.0.0"
    },
    "receipt_id": {
      "const": "lesson-factory-deadline-2026-08-03-source-use-01"
    },
    "decided_at": {
      "$ref": "shared-vocabulary.schema.json#/$defs/IsoTimestamp"
    },
    "decision_role": {
      "const": "PRODUCT_PEDAGOGY_OWNER"
    },
    "decision_scope": {
      "type": "object",
      "additionalProperties": false,
      "description": "What the decision is about, and the six things it is not. Each refusal is a const rather than a boolean an instance chooses, because a receipt that could say otherwise is one somebody eventually uses to say otherwise.",
      "required": [
        "applies_to",
        "grants_lesson_approval",
        "grants_external_source_copying",
        "grants_rights_clearance_for_third_party_material",
        "is_legal_advice",
        "is_third_party_license",
        "establishes_efficacy",
        "establishes_calibration"
      ],
      "properties": {
        "applies_to": {
          "const": "DEADLINE_CANDIDATE_INTERNAL_AUTHORING"
        },
        "grants_lesson_approval": {
          "const": false
        },
        "grants_external_source_copying": {
          "const": false
        },
        "grants_rights_clearance_for_third_party_material": {
          "const": false
        },
        "is_legal_advice": {
          "const": false
        },
        "is_third_party_license": {
          "const": false
        },
        "establishes_efficacy": {
          "const": false
        },
        "establishes_calibration": {
          "const": false
        }
      }
    },
    "source_decisions": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "uniqueItems": true,
      "description": "One row per source id the curriculum cites. Exactly these thirteen, in this order: a shorter table leaves a cited source undecided, and a longer one decides about a source nothing cites.",

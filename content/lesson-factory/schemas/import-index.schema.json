{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcat-mastery.internal/lesson-factory/schemas/v1/import-index.schema.json",
  "x_contract_id": "lesson-factory.import-index",
  "x_contract_version": "3.0.0",
  "title": "Import index",
  "description": "What an importer may read from a kit. Every entry pins its own bytes, the import target is a candidate draft namespace that serves no learner, and identity reconstruction is refused: an entry that cannot state its exact hashes is rejected rather than repaired.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "contract_version",
    "index_id",
    "generated_at",
    "kit_ref",
    "entries",
    "import_target",
    "identity_reconstruction_allowed",
    "nonclaims"
  ],
  "properties": {
    "contract_id": {
      "const": "lesson-factory.import-index"
    },
    "contract_version": {
      "const": "3.0.0",
      "description": "The one contract version this schema describes. An instance that claims another version was validated against a contract that is not this one."
    },
    "index_id": {
      "$ref": "shared-vocabulary.schema.json#/$defs/ImportIndexId"
    },
    "generated_at": {
      "$ref": "shared-vocabulary.schema.json#/$defs/IsoTimestamp"
    },
    "kit_ref": {
      "$ref": "shared-vocabulary.schema.json#/$defs/KitRef"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lesson_id",
          "lesson_revision_id",
          "bundle_ref",
          "lesson_handoff_ref",
          "content_sha256",
          "readiness_status"
        ],
        "properties": {
          "lesson_id": {
            "$ref": "shared-vocabulary.schema.json#/$defs/LessonId"
          },
          "lesson_revision_id": {
            "$ref": "shared-vocabulary.schema.json#/$defs/LessonRevisionId"
          },
          "bundle_ref": {
            "$ref": "shared-vocabulary.schema.json#/$defs/BundleRef"
          },
          "lesson_handoff_ref": {
            "$ref": "shared-vocabulary.schema.json#/$defs/HandoffRef"
          },
          "content_sha256": {
            "$ref": "shared-vocabulary.schema.json#/$defs/Sha256"
          },
          "readiness_status": {
            "const": "READY_FOR_CANDIDATE_IMPORT"
          }
        }
      }
    },
    "import_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "serves_learners", "catalog_registration"],
      "properties": {
        "namespace": {
          "const": "CANDIDATE_DRAFT_IMPORT"
        },
        "serves_learners": {
          "const": false
        },
        "catalog_registration": {
          "const": false
        }
      }
    },
    "identity_reconstruction_allowed": {
      "const": false
    },
    "nonclaims": {
      "$ref": "shared-vocabulary.schema.json#/$defs/Nonclaims"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcat-mastery.internal/lesson-factory/schemas/v1/lesson-handoff.schema.json",
  "x_contract_id": "lesson-factory.lesson-handoff",
  "x_contract_version": "4.0.0",
  "title": "Lesson handoff",
  "description": "What one authoring lane hands back for one lesson revision: pinned identity, the structural validation that cleared it, the four-member route proof it was authored against, a learner-safe summary, and a server-only reference to its protected material. It hands back no verdict.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "contract_version",
    "handoff_id",
    "produced_by_lane_id",
    "produced_at",
    "lesson_identity",
    "task_packet_ref",
    "deadline_profile_ref",
    "release_policy_ref",
    "candidate_quality_ledger_ref",
    "draft_location",
    "structural_validation",
    "route_proofs",
    "learner_safe_summary",
    "protected_material_reference",
    "author_diagnostics",
    "nonclaims",
    "route_scope_code",
    "applicable_routes",
    "ratified_policy_version"
  ],
  "properties": {
    "contract_id": {
      "const": "lesson-factory.lesson-handoff"
    },
    "contract_version": {
      "const": "4.0.0",
      "description": "The one contract version this schema describes. An instance that claims another version was validated against a contract that is not this one."
    },
    "handoff_id": {
      "$ref": "shared-vocabulary.schema.json#/$defs/HandoffId"
    },
    "produced_by_lane_id": {
      "$ref": "shared-vocabulary.schema.json#/$defs/LaneId"
    },
    "produced_at": {
      "$ref": "shared-vocabulary.schema.json#/$defs/IsoTimestamp"
    },
    "lesson_identity": {
      "$ref": "shared-vocabulary.schema.json#/$defs/LessonIdentity"
    },
    "task_packet_ref": {
      "$ref": "shared-vocabulary.schema.json#/$defs/PacketRef"
    },
    "deadline_profile_ref": {
      "$ref": "shared-vocabulary.schema.json#/$defs/ProfileRef"
    },
    "release_policy_ref": {
      "$ref": "shared-vocabulary.schema.json#/$defs/FrozenReleasePolicyRef"
    },
    "candidate_quality_ledger_ref": {
      "$ref": "shared-vocabulary.schema.json#/$defs/LedgerRef"
    },
    "draft_location": {
      "$ref": "shared-vocabulary.schema.json#/$defs/OutputDirectory"
    },
    "structural_validation": {
      "$ref": "shared-vocabulary.schema.json#/$defs/StructuralValidation"
    },
    "route_proofs": {
      "$ref": "shared-vocabulary.schema.json#/$defs/RouteProofs"
    },
    "learner_safe_summary": {
      "type": "object",
      "additionalProperties": false,
      "description": "Everything here may be read by anyone. Keys, accepted-answer sets, scoring material, and private rationale are structurally absent, not merely discouraged — and so is any field that could hold them. The title is referenced rather than restated: a free-text title field on a learner-safe surface is a free-text field on a learner-safe surface, whatever it is called.",
      "required": ["lesson_title_ref", "ordered_kc_ids", "node_count", "item_count"],
      "properties": {
        "lesson_title_ref": {
          "$ref": "shared-vocabulary.schema.json#/$defs/TitleRef"
        },
        "ordered_kc_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "shared-vocabulary.schema.json#/$defs/KcId"
          }
        },
        "node_count": {
          "type": "integer",
          "minimum": 1
        },
        "item_count": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "protected_material_reference": {
      "$ref": "shared-vocabulary.schema.json#/$defs/ProtectedMaterialReference"
    },
    "author_diagnostics": {
      "$ref": "shared-vocabulary.schema.json#/$defs/AuthorDiagnostics"
    },
    "nonclaims": {
      "$ref": "shared-vocabulary.schema.json#/$defs/Nonclaims"
    },
    "route_scope_code": {
      "$ref": "shared-vocabulary.schema.json#/$defs/RouteScopeCode"
    },
    "applicable_routes": {
      "$ref": "shared-vocabulary.schema.json#/$defs/RouteList"
    },
    "ratified_policy_version": {
      "$ref": "shared-vocabulary.schema.json#/$defs/SemanticVersion"
    }
  },
  "allOf": [
    {
      "$ref": "shared-vocabulary.schema.json#/$defs/RouteScopeBinding"
    }
  ],
  "$comment": "Route applicability is supplied by the frozen release policy, never chosen here: the document carries the policy reference, the ratified version, and the scope code, and the shared route binding derives the four proofs and their clauses from that code. A packet or handoff authored against a route the policy does not cover cannot validate."
}

            "ref",
            "contract_id",
            "contract_version",
            "schema_file",
            "schema_locator"
          ]
        }
      },
      "required": [
        "document"
      ]
    },
    {
      "$comment": "readiness documents are lesson-factory.bundle-readiness at 4.0.0, validated against bundle-readiness.schema.json, and named by a canonical readiness reference.",
      "type": "object",
      "properties": {
        "document": {
          "type": "object",
          "properties": {
            "kind": {
              "const": "readiness"
            },
            "ref": {
              "$ref": "shared-vocabulary.schema.json#/$defs/ReadinessRef"
            },
            "contract_id": {
              "const": "lesson-factory.bundle-readiness"
            },
            "contract_version": {
              "const": "4.0.0"
            },
            "schema_file": {
              "const": "bundle-readiness.schema.json"
            },
            "schema_locator": {
              "const": "content/lesson-factory/schemas/bundle-readiness.schema.json"
            }
          },
          "required": [
            "kind",
            "ref",
            "contract_id",
            "contract_version",
            "schema_file",
            "schema_locator"
          ]
        }
      },
      "required": [
        "document"
      ]
    }
  ],
  "allOf": [
    {
      "$comment": "A record cannot be admitted unless all three halves passed. This is the rule that makes an Ajv-only consumer unable to produce an ADMITTED record: it has nothing to put in resolver_validation and nothing to put in input_validation.",
      "if": {
        "type": "object",
        "properties": {
          "admission": {
            "const": "ADMITTED"
          }
        },
        "required": [
          "admission"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "schema_validation": {
            "type": "object",
            "properties": {
              "status": {
                "const": "PASS"
              },
              "error_count": {
                "const": 0
              }
            }
          },
          "resolver_validation": {
            "type": "object",
            "properties": {
              "status": {
                "const": "PASS"
              },
              "unresolved_count": {
                "const": 0
              },
              "references": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "enum": [
                        "RESOLVED",
                        "IDENTITY_ONLY"
                      ]
                    }
                  }
                }
              }
            }
          },
          "input_validation": {
            "type": "object",
            "properties": {
              "status": {
                "const": "PASS"
              },
              "unresolved_count": {
                "const": 0
              },
              "inputs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "fileStatus": {
                      "const": "RESOLVED"
                    },
                    "contentStatus": {
                      "const": "RESOLVED"
                    }
                  }
                }
              }
            }
          },
          "semantic_validation": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "PASS",
                  "NOT_APPLICABLE"
                ]
              },
              "error_count": {
                "const": 0
              }
            }
          }
        }
      }
    },
    {
      "$comment": "And the converse, so a record cannot pass every applicable validation and then withhold admission for a reason it does not state.",
      "if": {
        "type": "object",
        "properties": {
          "schema_validation": {
            "type": "object",
            "properties": {
              "status": {
                "const": "PASS"
              }
            },
            "required": [
              "status"
            ]
          },
          "resolver_validation": {
            "type": "object",
            "properties": {
              "status": {
                "const": "PASS"
              }
            },
            "required": [
              "status"
            ]
          },
          "input_validation": {
            "type": "object",
            "properties": {
              "status": {
                "const": "PASS"
              }
            },
            "required": [
              "status"
            ]
          },
          "semantic_validation": {
            "type": "object",
            "properties": {
              "status": {
                "enum": [
                  "PASS",
                  "NOT_APPLICABLE"
                ]
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "schema_validation",
          "resolver_validation",
          "input_validation"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "admission": {
            "const": "ADMITTED"
          }
        }
      }
    },
    {
      "$comment": "Packet and quarantine-packet documents run the packet semantic validator; every other admitted contract records that the packet-only validator is not applicable.",
      "if": {
        "type": "object",
        "required": [
          "document"
        ],
        "properties": {
          "document": {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "packet",
                  "quarantine-packet"
                ]
              }
            }
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "semantic_validation"
        ],
        "properties": {
          "semantic_validation": {
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "enum": [
                  "PASS",
                  "FAIL",
                  "NOT_RUN"
                ]
              }
            }
          }
        }
      },
      "else": {
        "type": "object",
        "required": [
          "semantic_validation"
        ],
        "properties": {
          "semantic_validation": {
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "NOT_APPLICABLE"
              }
            }
          }
        }
      }
    },
    {
      "$comment": "A packet-semantic contradiction has one stable refusal code and can never be admitted.",
      "if": {
        "type": "object",
        "required": [
          "semantic_validation"
        ],
        "properties": {
          "semantic_validation": {
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "FAIL"
              }
            }
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "admission",
          "refusal_code"
        ],
        "properties": {
          "admission": {
            "const": "REJECTED"
          },
          "refusal_code": {
            "const": "PACKET_SEMANTICS_INVALID"
          }
        }
      }
    },
    {
      "$comment": "NOT_RUN is an ordering fact: an earlier validation failed, so packet semantics did not run and the document cannot be admitted.",
      "if": {
        "type": "object",
        "required": [
          "semantic_validation"
        ],
        "properties": {
          "semantic_validation": {
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "const": "NOT_RUN"
              }
            }
          }
        }
      },
      "then": {
        "type": "object",
        "required": [
          "admission"
        ],
        "properties": {
          "admission": {
            "const": "REJECTED"
          }
        }
      }
    },
    {
      "$comment": "A refusal says why, and an admission does not carry a reason for a refusal that did not happen.",
      "if": {
        "type": "object",
        "properties": {
          "admission": {
            "const": "REJECTED"
          }
        },
        "required": [
          "admission"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "refusal_code": {
            "oneOf": [
              {
                "$ref": "shared-vocabulary.schema.json#/$defs/IntakeRefusalCode"
              },
              {
                "const": "PACKET_SEMANTICS_INVALID"
              }
            ]
          }
        },
        "required": [
          "refusal_code"
        ]
      },
      "else": {
        "type": "object",
        "properties": {
          "refusal_code": false
        }
      }
    },
    {
      "$comment": "A count of zero over a non-empty list of references is the shape of a caller reporting that it checked nothing. The exact count is bound by the admission proof; this is the part a validator can see on its own.",
      "if": {
        "type": "object",
        "properties": {
          "resolver_validation": {
            "type": "object",
            "properties": {
              "references": {
                "type": "array",
                "contains": {}
              }
            },
            "required": [
              "references"
            ]
          }
        },
        "required": [
          "resolver_validation"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "resolver_validation": {
            "type": "object",
            "properties": {
              "checked_count": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    {
      "$comment": "And the converse: a document with references checked cannot report no rows.",
      "if": {
        "type": "object",
        "properties": {
          "resolver_validation": {
            "type": "object",
            "properties": {
              "checked_count": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "checked_count"
            ]
          }
        },
        "required": [
          "resolver_validation"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "resolver_validation": {
            "type": "object",
            "properties": {
              "references": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "$comment": "A reference that did not resolve is an unadmitted document, however the counts were written.",
      "if": {
        "type": "object",
        "properties": {
          "resolver_validation": {
            "type": "object",
            "properties": {
              "references": {
                "type": "array",
                "contains": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "enum": [
                        "NOT_YET_PRODUCED",
                        "MISMATCHED",
                        "MALFORMED"
                      ]
                    }
                  },
                  "required": [
                    "status"
                  ]
                }
              }
            },
            "required": [
              "references"
            ]
          }
        },
        "required": [
          "resolver_validation"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "admission": {
            "const": "REJECTED"
          },
          "resolver_validation": {
            "type": "object",
            "properties": {
              "status": {
                "const": "FAIL"
              },
              "unresolved_count": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    {
      "$comment": "And an input row that did not resolve is an input row the record has to count. A list with a failure in it and an unresolved count of zero is the shape of a caller reporting a check it did not act on.",
      "if": {
        "type": "object",
        "properties": {
          "input_validation": {
            "type": "object",
            "properties": {
              "inputs": {
                "type": "array",
                "contains": {
                  "type": "object",
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "fileStatus": {
                          "enum": [
                            "MISMATCHED",
                            "MISSING"
                          ]
                        }
                      },
                      "required": [
                        "fileStatus"
                      ]
                    },
                    {
                      "type": "object",
                      "properties": {
                        "contentStatus": {
                          "enum": [
                            "MISMATCHED",
                            "MISSING"
                          ]
                        }
                      },
                      "required": [
                        "contentStatus"
                      ]
                    }
                  ]
                }
              }
            },
            "required": [
              "inputs"
            ]
          }
        },
        "required": [
          "input_validation"
        ]
      },
      "then": {
        "type": "object",
        "properties": {
          "input_validation": {
            "type": "object",
            "properties": {
              "status": {
                "const": "FAIL"
              },
              "unresolved_count": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "admission": {
            "const": "REJECTED"
          }
        }
      }
    }
  ]
}

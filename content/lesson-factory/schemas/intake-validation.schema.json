{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcat-mastery.internal/lesson-factory/schemas/v1/intake-validation.schema.json",
  "x_contract_id": "lesson-factory.intake-validation",
  "x_contract_version": "2.1.0",
  "title": "Intake validation record",
  "description": "The record a consumer must produce before it may say a lesson-factory document is valid, and the document that record is about. Schema validation answers whether a document has the shape a contract describes; it cannot answer whether the references inside it point at bytes that exist and hash to what they claim, because JSON Schema cannot read a second file. Both halves are required. And both halves are about one document: a record names the offered bytes by canonical reference and by digest, names the contract and the exact contract version those bytes were validated against, and carries a proof over the whole derivation — so an admission cannot be written about a kind of document, cannot survive an edit to the document, and cannot be authored by anyone who did not do the work.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_id",
    "contract_version",
    "document",
    "schema_validation",
    "resolver_validation",
    "admission",
    "admission_proof",
    "validated_at"
  ],
  "properties": {
    "contract_id": {
      "const": "lesson-factory.intake-validation"
    },
    "contract_version": {
      "const": "2.1.0",
      "description": "The one contract version this schema describes. An instance that claims another version was validated against a contract that is not this one."
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "description": "The exact document that was offered. Every field here is derived by the intake API from the offered bytes and the trusted contract registry; none of them is a caller input. The four identity fields are pinned together by the oneOf below, so a profile cannot be filed as a handoff even when every digest in the record is real.",
      "required": [
        "kind",
        "ref",
        "sha256",
        "contract_id",
        "contract_version",
        "schema_file",
        "schema_locator",
        "schema_sha256"
      ],
      "properties": {
        "kind": {
          "$ref": "shared-vocabulary.schema.json#/$defs/ReferenceKindCode",
          "description": "What was offered, named by the reference kind that points at documents of its contract."
        },
        "ref": {
          "type": "string",
          "pattern": "^(?:profile|policy|lifecycle|receipt|assignment|packet|handoff|team-handoff|ledger|kit|import-index|readiness):[A-Za-z0-9._/@-]+#sha256:[0-9a-f]{64}$",
          "description": "The canonical pinned reference to the offered bytes: kind, canonical locator, and digest. The oneOf narrows this to the locator grammar of the declared kind, so the locator cannot belong to a different sort of thing."
        },
        "sha256": {
          "$ref": "shared-vocabulary.schema.json#/$defs/Sha256",
          "description": "The digest of the offered bytes, exactly as read. It is the same digest the reference carries; carrying it twice is what lets a consumer check the reference against the content without parsing the reference."
        },
        "contract_id": {
          "$ref": "shared-vocabulary.schema.json#/$defs/AdmissibleContractId"
        },
        "contract_version": {
          "$ref": "shared-vocabulary.schema.json#/$defs/SemanticVersion",
          "description": "The exact contract version the document was validated against, pinned per kind below. A record that does not say which version it applied is a record of an unrepeatable check."
        },
        "schema_file": {
          "$ref": "shared-vocabulary.schema.json#/$defs/ContractSchemaFile"
        },
        "schema_locator": {
          "$ref": "shared-vocabulary.schema.json#/$defs/ContractSchemaLocator"
        },
        "schema_sha256": {
          "$ref": "shared-vocabulary.schema.json#/$defs/Sha256",
          "description": "The digest of the contract bytes that were applied. A contract is an authority like any other in this freeze, so it is pinned like one."
        }
      }
    },
    "schema_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "error_count"],
      "description": "The half a validator can do alone.",
      "properties": {
        "status": {
          "$ref": "shared-vocabulary.schema.json#/$defs/GateStatus"
        },
        "error_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "resolver_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "checked_count", "unresolved_count", "references"],
      "description": "The half that requires reading the referenced bytes: kind, canonical locator, target existence, and digest. The rows are discovered from the offered document using the contract and the reference model, never supplied: a caller that hands intake an empty list has told it there was nothing to check.",
      "properties": {
        "status": {
          "$ref": "shared-vocabulary.schema.json#/$defs/GateStatus"
        },
        "checked_count": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved_count": {
          "type": "integer",
          "minimum": 0
        },
        "references": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "kind", "digest", "status"],
            "properties": {
              "field": {
                "$ref": "shared-vocabulary.schema.json#/$defs/JsonPointer",
                "description": "Where in the offered document the reference was found."
              },
              "kind": {
                "$ref": "shared-vocabulary.schema.json#/$defs/ReferenceKindCode"
              },
              "digest": {
                "$ref": "shared-vocabulary.schema.json#/$defs/ObservedDigest",
                "description": "The digest that reference claimed, as read from the document."
              },
              "status": {
                "$ref": "shared-vocabulary.schema.json#/$defs/ResolutionStatus"
              }
            }
          }
        }
      }
    },
    "admission": {
      "$ref": "shared-vocabulary.schema.json#/$defs/IntakeAdmission",
      "description": "Derived, never asserted: ADMITTED requires both halves to have passed over these bytes, and the proof below to have been computed over the derivation that produced it."
    },
    "refusal_code": {
      "$ref": "shared-vocabulary.schema.json#/$defs/IntakeRefusalCode",
      "description": "Why the document was refused. Present exactly when the admission is REJECTED."
    },
    "admission_proof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["derivation", "derivation_sha256"],
      "description": "A digest over the whole derivation: the offered digest, the derived identity, both validation results, and every reference row. It is not a secret and is not meant to be one — it is a binding. To write a record that survives recomputation you have to have the bytes it names, apply the contract it names, and get the results it reports, which is the same as having done the work.",
      "properties": {
        "derivation": {
          "$ref": "shared-vocabulary.schema.json#/$defs/IntakeDerivation"
        },
        "derivation_sha256": {
          "$ref": "shared-vocabulary.schema.json#/$defs/Sha256"
        }
      }
    },
    "validated_at": {
      "$ref": "shared-vocabulary.schema.json#/$defs/IsoTimestamp"
    }
  },
  "oneOf": [

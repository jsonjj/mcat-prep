  "allOf": [
    {
      "$comment": "A record cannot be admitted unless both halves passed. This is the rule that makes an Ajv-only consumer unable to produce an ADMITTED record: it has nothing to put in resolver_validation.",
      "if": {
        "type": "object",
        "properties": {
          "admission": {
            "const": "ADMITTED"
          }
        },
        "required": ["admission"]
      },
      "then": {
        "type": "object",
        "properties": {
          "schema_validation": {
            "type": "object",
            "properties": {
              "status": {
                "const": "PASS"
              },
              "error_count": {
                "const": 0
              }
            }
          },
          "resolver_validation": {
            "type": "object",
            "properties": {
              "status": {
                "const": "PASS"
              },
              "unresolved_count": {
                "const": 0
              },
              "references": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "enum": ["RESOLVED", "IDENTITY_ONLY"]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "$comment": "And the converse, so a record cannot pass both halves and then withhold admission for a reason it does not state.",
      "if": {
        "type": "object",
        "properties": {
          "schema_validation": {
            "type": "object",
            "properties": {
              "status": {
                "const": "PASS"
              }
            },
            "required": ["status"]
          },
          "resolver_validation": {
            "type": "object",
            "properties": {
              "status": {
                "const": "PASS"
              }
            },
            "required": ["status"]
          }
        },
        "required": ["schema_validation", "resolver_validation"]
      },
      "then": {
        "type": "object",
        "properties": {
          "admission": {
            "const": "ADMITTED"
          }
        }
      }
    },
    {
      "$comment": "A refusal says why, and an admission does not carry a reason for a refusal that did not happen.",
      "if": {
        "type": "object",
        "properties": {
          "admission": {
            "const": "REJECTED"
          }
        },
        "required": ["admission"]
      },
      "then": {
        "type": "object",
        "properties": {
          "refusal_code": {
            "$ref": "shared-vocabulary.schema.json#/$defs/IntakeRefusalCode"
          }
        },
        "required": ["refusal_code"]
      },
      "else": {
        "type": "object",
        "properties": {
          "refusal_code": false
        }
      }
    },
    {
      "$comment": "A count of zero over a non-empty list of references is the shape of a caller reporting that it checked nothing. The exact count is bound by the admission proof; this is the part a validator can see on its own.",
      "if": {
        "type": "object",
        "properties": {
          "resolver_validation": {
            "type": "object",
            "properties": {
              "references": {
                "type": "array",
                "contains": {}
              }
            },
            "required": ["references"]
          }
        },
        "required": ["resolver_validation"]
      },
      "then": {
        "type": "object",
        "properties": {
          "resolver_validation": {
            "type": "object",
            "properties": {
              "checked_count": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        }
      }
    },
    {
      "$comment": "And the converse: a document with references checked cannot report no rows.",
      "if": {
        "type": "object",
        "properties": {
          "resolver_validation": {
            "type": "object",
            "properties": {
              "checked_count": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": ["checked_count"]
          }
        },
        "required": ["resolver_validation"]
      },
      "then": {
        "type": "object",
        "properties": {
          "resolver_validation": {
            "type": "object",
            "properties": {
              "references": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      }
    },
    {
      "$comment": "A reference that did not resolve is an unadmitted document, however the counts were written.",
      "if": {
        "type": "object",
        "properties": {
          "resolver_validation": {
            "type": "object",
            "properties": {
              "references": {
                "type": "array",
                "contains": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "enum": ["NOT_YET_PRODUCED", "MISMATCHED", "MALFORMED"]
                    }
                  },
                  "required": ["status"]
                }
              }
            },
            "required": ["references"]
          }
        },
        "required": ["resolver_validation"]
      },
      "then": {
        "type": "object",
        "properties": {
          "admission": {

      {
        "node_id": "QUIN-NODE-CONTRAST",
        "node_kind": "CONTRAST_BOUNDARY",
        "primary_kc_id": "V3-KC-271440",
        "secondary_kc_refs": [],
        "route_eligibility": [
          "STANDARD"
        ],
        "learner_content_blocks": [
          "Boundary: the net two-electron equation does not mean every mechanistic step must transfer two electrons simultaneously; it states the overall conversion between fully oxidized and fully reduced forms.",
          "Non-example: shortening the hydrophobic tail can alter localization but does not by itself convert quinone carbonyls to hydroquinone hydroxyls."
        ],
        "representation_ids": [
          "QUIN-REP"
        ],
        "activity_ids": [],

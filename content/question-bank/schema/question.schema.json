{
  "$ref": "#/definitions/Question",
  "definitions": {
    "Question": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "default": "v7"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "section": {
          "type": "string",
          "enum": [
            "BB",
            "CARS",
            "CP",
            "PS",
            "CROSS_SECTION"
          ]
        },
        "stem": {
          "type": "string",
          "minLength": 1
        },
        "choices": {
          "type": "object",
          "properties": {
            "A": {
              "type": "string",
              "minLength": 1
            },
            "B": {
              "type": "string",
              "minLength": 1
            },
            "C": {
              "type": "string",
              "minLength": 1
            },
            "D": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "A",
            "B",
            "C",
            "D"
          ],
          "additionalProperties": false
        },
        "passage": {
          "type": "string",
          "default": ""
        },
        "correct_answer": {
          "type": "string",
          "enum": [
            "A",
            "B",
            "C",
            "D"
          ]
        },
        "explanations": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          },
          "propertyNames": {
            "enum": [
              "A",
              "B",
              "C",
              "D"
            ]
          }
        },
        "subject": {
          "type": "string"
        },
        "primary_skill": {
          "type": "string",
          "minLength": 1
        },
        "primary_kc_id": {
          "type": "string"
        },
        "primary_kc_label": {
          "type": "string"
        },
        "secondary_skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "secondary_kc_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "covered_kc_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "family_id": {
          "type": "string"
        },
        "dok_level": {
          "type": "integer"
        },
        "dok_rationale": {
          "type": "string"
        },
        "construct": {
          "type": "object",
          "properties": {
            "reasoning_operation_id": {
              "type": "string"
            },
            "topic_id": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "surface": {
          "type": "object",
          "properties": {
            "context_domain": {
              "type": "string"
            },
            "distractor_structure": {
              "type": "string"
            },
            "representation": {
              "type": "string"
            },
            "value_set": {
              "type": "string"
            }
          },
          "additionalProperties": true
        },
        "transfer_dimensions_changed": {},
        "lesson_id": {
          "type": "string"
        },
        "lesson_label": {
          "type": "string"
        },
        "pool": {
          "type": "string"
        },
        "source_item_id": {
          "type": "string"
        },
        "source_pool": {
          "type": "string"
        },
        "quality": {},
        "status": {
          "type": "string"
        },
        "error_models": {},
        "empirical_calibration": {},
        "exposure_status": {},
        "human_sme_review": {},
        "certification_stage": {},
        "assets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "none",
                  "table",
                  "plot",
                  "diagram",
                  "molecule_2d",
                  "molecule_3d",
                  "equation",
                  "annotated_diagram"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "needed",
                  "generating",
                  "ready"
                ],
                "default": "needed"
              },
              "spec": {
                "type": "string",
                "default": ""
              },
              "alt": {
                "type": "string",
                "default": ""
              },
              "storage_key": {
                "type": [
                  "string",
                  "null"
                ],
                "default": null
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": true
          },
          "default": []
        }
      },
      "required": [
        "id",
        "section",
        "stem",
        "choices",
        "correct_answer",
        "explanations"
      ],
      "additionalProperties": true
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}

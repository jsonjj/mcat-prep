{
  "$ref": "#/definitions/Stimulus",
  "definitions": {
    "Stimulus": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "string",
          "default": "v7"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "section": {
          "type": "string",
          "enum": [
            "BB",
            "CARS",
            "CP",
            "PS",
            "CROSS_SECTION"
          ]
        },
        "body": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "assets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "none",
                  "table",
                  "plot",
                  "diagram",
                  "molecule_2d",
                  "molecule_3d",
                  "equation",
                  "annotated_diagram"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "needed",
                  "generating",
                  "ready"
                ],
                "default": "needed"
              },
              "spec": {
                "type": "string",
                "default": ""
              },
              "alt": {
                "type": "string",
                "default": ""
              },
              "storage_key": {
                "type": [
                  "string",
                  "null"
                ],
                "default": null
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": true
          },
          "default": []
        }
      },
      "required": [
        "id",
        "section",
        "body"
      ],
      "additionalProperties": true
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}

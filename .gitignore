# Dependencies & package-manager state
node_modules/
.pnpm-store/
.pnpm-cache/
.pnpm-state/
.npm-cache/
.tooling/
.xdg-cache/

# Build output
dist/
build/
out/
coverage/
*.tsbuildinfo
.turbo/
.vite/
.react-router/
cdk.out/

# Local env & secrets (NEVER commit secrets; server secrets live in AWS Secrets Manager)
.env
.env.*
!.env.example
*.pem
*.key

# OS / editor
.DS_Store
Thumbs.db
*.log

# Test / tooling artifacts
playwright-report/
test-results/
.vitest/
.tmp/

# Copyright guardrail: never commit source PDFs or any derivative of the reference
# question/passage material (screenshots, OCR text, embeddings, extracted pages).
*.pdf
.tmp_pg_inspect/
research-derivatives/

# Protected content compilation output must never be committed (goes to private S3 in prod;
# local candidate output stays out of git).
generated/protected/
content/**/protected-compiled/
*.answer-key.json

# Raw question candidate drops may carry protected evaluation material. Keep JSONL
# drops out of git; only compiled learner-safe payloads may ever be committed/shipped.
/question-bank/*.jsonl

# Optional 3D model assets: commit ONLY vetted CC0/licensed models (with ATTRIBUTION.md)
# via an explicit `git add -f`, so an unlicensed model can't be committed by accident.
apps/learner-web/public/models/*.glb
apps/learner-web/public/models/*.gltf
apps/learner-web/public/models/*.bin

# Dependencies & package-manager state
node_modules/
.pnpm-store/
.pnpm-cache/
.pnpm-state/
.npm-cache/
.tooling/

# Build output
dist/
build/
out/
coverage/
*.tsbuildinfo
.turbo/
.vite/

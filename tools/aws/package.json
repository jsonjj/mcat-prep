{
  "name": "@mcat/aws-tools",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "preflight": "node --import tsx src/preflight.ts",
    "review:dev": "node --import tsx src/preflight.ts prepare-review",
    "deploy:dev": "node --import tsx src/deploy.ts",
    "migrate:dev": "node --import tsx src/migrate.ts",
    "migrate:ci": "node --import tsx src/migrate-ci.ts",
    "migrate:ci-lambda": "node --import tsx src/migrate-ci-lambda.ts",
    "publish:web": "node --import tsx src/publish-web.ts",
    "smoke": "node --import tsx src/smoke.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mcat/database": "workspace:*",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/pg": "8.20.0",
    "tsx": "4.23.1",
    "typescript": "5.7.3",
    "vitest": "4.1.11"
  }
}

{
  "name": "@mcat/infra-cdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "synth": "cdk synth --strict",
    "diff:dev": "cdk diff 'McatDev*' --profile sbsandbox",
    "deploy:dev": "pnpm --filter @mcat/aws-tools deploy:dev"
  },
  "dependencies": {
    "aws-cdk-lib": "2.261.0",
    "constructs": "10.7.1"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "aws-cdk": "2.1132.0",
    "cdk-nag": "3.0.1",
    "esbuild": "0.28.1",
    "tsx": "4.23.1",
    "typescript": "5.7.3",
    "vitest": "3.2.6"
  }
}

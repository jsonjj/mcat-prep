        "primary_kc_id": "V3-KC-452593",
        "secondary_kc_refs": [],
        "route_eligibility": ["CONCISE", "STANDARD", "MISCONCEPTION", "PREREQUISITE_SUPPORT"],
        "learner_content_blocks": [
          "Mental model: decode the graph's encoding layer first, then operate on the relationship layer."
        ],
        "representation_ids": ["TPL-GRAPH-REP-SCALE"],
        "activity_ids": [],
        "checkpoint_ref": "TPL-GRAPH-CP-MODEL",
        "source_claim_refs": ["TPL-GRAPH-CLAIM"]
      },
      {
        "node_id": "TPL-GRAPH-NODE-THINK",
        "node_kind": "EXPERT_THINK_ALOUD",
        "primary_kc_id": "V3-KC-452593",
        "secondary_kc_refs": [],
        "route_eligibility": ["CONCISE", "STANDARD", "MISCONCEPTION", "PREREQUISITE_SUPPORT"],
        "learner_content_blocks": [
          "Think aloud: I read time on the horizontal axis and distance on the vertical axis. From (2, 6) to (5, 18), the slope is (18 - 6) / (5 - 2) = 4 distance units per time unit."
        ],
        "representation_ids": ["TPL-GRAPH-REP-SLOPE"],
        "activity_ids": [],
        "checkpoint_ref": "TPL-GRAPH-CP-THINK",
        "source_claim_refs": ["TPL-GRAPH-CLAIM"]

        "primary_kc_id": "V3-KC-452593",
        "secondary_kc_refs": [],
        "route_eligibility": ["CONCISE", "STANDARD", "MISCONCEPTION", "PREREQUISITE_SUPPORT"],
        "learner_content_blocks": [
          "Equal spacing with labels 0, 10, and 20 means equal addition. Equal spacing with labels 1, 10, and 100 means equal multiplication by ten.",
          "For a linear graph, slope is vertical change divided by horizontal change. Keep the axis units with that relationship."
        ],
        "representation_ids": ["TPL-GRAPH-REP-SCALE"],
        "activity_ids": [],
        "checkpoint_ref": "TPL-GRAPH-CP-EXPLANATION",
        "source_claim_refs": ["TPL-GRAPH-CLAIM"]
      },
      {
        "node_id": "TPL-GRAPH-NODE-MODEL",

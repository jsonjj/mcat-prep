        "learner_content_blocks": [
          "Starting check: use the labelled ticks to decide whether equal visual steps add or multiply. This is a low-stakes observation."
        ],
        "representation_ids": ["TPL-GRAPH-REP-SCALE"],
        "activity_ids": ["TPL-GRAPH-ACT-ENTRY"],
        "checkpoint_ref": "TPL-GRAPH-CP-ENTRY",

        "secondary_kc_refs": [],
        "route_eligibility": ["CONCISE", "STANDARD", "MISCONCEPTION", "PREREQUISITE_SUPPORT"],
        "learner_content_blocks": [
          "Worked example: a vertical axis shows 2, 20, and 200 at equally spaced positions. Each step multiplies by ten, so the axis is logarithmic rather than linear.",
          "A separate linear graph moves from (1, 3) to (4, 15). Its slope is (15 - 3) / (4 - 1) = 4 vertical units per horizontal unit."
        ],
        "representation_ids": ["TPL-GRAPH-REP-SCALE", "TPL-GRAPH-REP-SLOPE"],
        "activity_ids": [],
        "checkpoint_ref": "TPL-GRAPH-CP-WORKED",

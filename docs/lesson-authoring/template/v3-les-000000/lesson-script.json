        "secondary_kc_refs": [],
        "route_eligibility": ["CONCISE", "STANDARD", "MISCONCEPTION", "PREREQUISITE_SUPPORT"],
        "learner_content_blocks": [
          "Focus now: a graph encodes how two quantities relate. Read each axis title, unit, and labelled tick pattern before calculating."
        ],
        "representation_ids": ["TPL-GRAPH-REP-SCALE"],
        "activity_ids": [],
        "checkpoint_ref": "TPL-GRAPH-CP-ORIENTATION",
        "source_claim_refs": ["TPL-GRAPH-CLAIM"]
      },
      {

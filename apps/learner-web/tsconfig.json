{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["react", "react-dom", "vite/client", "node"],
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    // Relaxed to host the vendored app-native pilot lessons (src/app-native/*),
    // which were authored under the lesson-viewer config (these two flags off).
    // TODO: re-tighten once app-native is extracted into its own package.
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": false
  },
  "include": ["src", "server", "vite.config.ts"]
}

{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["react", "react-dom", "vite/client", "node"],
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    // Two base strictness flags stay off for this app. They were first relaxed to
    // host the (now-retired) app-native pilot lessons, but re-tightening after that
    // deletion still surfaces ~14 pre-existing errors in unrelated code — the recall
    // adapters (apkg-importer, media-store, recall-service) and a few screens
    // (AppShell, RecallHome, RecallReview) — that predate this work. Kept off here so
    // the removal stays a clean deletion; re-tightening + fixing those is deferred
    // roadmap work, not part of retiring the previews.
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": false
  },
  "include": ["src", "server", "vite.config.ts"]
}

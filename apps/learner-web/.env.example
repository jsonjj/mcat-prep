# Learner authority base URL (required — the client throws at boot without it).
#
# LOCAL DEV (default below): "/" routes API calls through the Vite dev proxy
# (see vite.config.ts), which forwards /v1 to the remote authority server-side so the
# browser stays same-origin and local dev is NOT blocked by CORS. Just copy this file:
#   cp apps/learner-web/.env.example apps/learner-web/.env.local
# PRODUCTION build: set an absolute origin instead, e.g.
#   VITE_AUTHORITY_BASE_URL=https://d2j72l2zhhn7o7.cloudfront.net
VITE_AUTHORITY_BASE_URL=/

# Optional: override the dev proxy upstream (defaults to the deployed dev authority):
# VITE_AUTHORITY_PROXY_TARGET=https://d2j72l2zhhn7o7.cloudfront.net

# CARS Duel AI opponent (dev proxy). Copy to `.env` (untracked) and fill in.
# The key is read ONLY by the Vite dev middleware (server-side) and is never
# exposed to the client bundle. In production this is replaced by a backend route.
#
# Works with any OpenAI-compatible /chat/completions endpoint.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

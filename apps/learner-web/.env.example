# Learner authority base URL (required — the client throws at boot without it).
#
# LOCAL DEV (default below): "/" keeps API calls same-origin, so the browser is
# never blocked by CORS. Just copy this file:
#   cp apps/learner-web/.env.example apps/learner-web/.env.local
# PRODUCTION build: set an absolute origin instead, e.g.
#   VITE_AUTHORITY_BASE_URL=https://d2j72l2zhhn7o7.cloudfront.net
VITE_AUTHORITY_BASE_URL=/

# Who answers same-origin /v1 in dev (see vite.config.ts):
#   unset (default) — the in-process dev authority, so the app runs fully offline
#                     with no deployed backend.
#   set             — the Vite dev server proxies /v1 to that remote authority
#                     server-side, presenting the deployed origin upstream.
# VITE_AUTHORITY_PROXY_TARGET=https://d2j72l2zhhn7o7.cloudfront.net

# AI features (CARS Duel opponent + "Explain it another way" grounded rewrite).
# Copy to `.env` (untracked) and fill in. The key is read ONLY server-side (the
# Vite dev middleware in dev; the deployed AI route in prod) and is never exposed
# to the client bundle. Works with any OpenAI-compatible /chat/completions
# endpoint. With no key set, the app still runs: CARS Duel shows an "offline"
# notice and "Explain it another way" falls back to a deterministic re-statement.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# PRODUCTION ONLY — where the grounded rewrite route is exposed (see
# @mcat/ai-gateway/server `handler`). Defaults to the dev proxy path
# `/api/ai/rewrite`; set this to the deployed same-origin route so the browser
# reaches it. If unset/unwired in prod, the feature degrades to the fallback.
# VITE_AI_REWRITE_URL=/v1/ai/rewrite

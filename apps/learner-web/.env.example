# Copy this file verbatim and you get a working `pnpm dev` (the real stack):
#   cp apps/learner-web/.env.example apps/learner-web/.env.local
# `pnpm dev` also needs the repo-root .env.local — see the root .env.example.
# For `pnpm dev:offline` instead, read the Supabase section below: it takes one
# extra edit, and skipping it does NOT give you an offline app.

# Learner authority base URL. REQUIRED IN BOTH MODES — the client throws
# "VITE_AUTHORITY_BASE_URL is required" at boot without it
# (src/app/authority.ts), so never delete this line.
#
# LOCAL DEV (default below): "/" keeps API calls same-origin, so the browser is
# never blocked by CORS.
# PRODUCTION build: set an absolute origin instead, e.g.
#   VITE_AUTHORITY_BASE_URL=https://d2j72l2zhhn7o7.cloudfront.net
VITE_AUTHORITY_BASE_URL=/

# Who answers same-origin /v1 in dev (see vite.config.ts). `pnpm dev` and
# `pnpm dev:offline` set the right one for you; these are here for the record:
#   VITE_AUTHORITY_LOCAL     — `pnpm dev`. A local run of the DEPLOYED learner API
#                              (services/local-learner-api) over a real Postgres,
#                              served over HTTPS. Needs the repo-root .env.local
#                              and the Supabase values below. See
#                              docs/runbooks/local-real-stack.md.
#   VITE_AUTHORITY_PROXY_TARGET — proxy /v1 to a deployed authority server-side,
#                              presenting the deployed origin upstream.
#   neither                  — `pnpm dev:offline`. The in-process dev authority,
#                              so the app runs fully offline with no backend.
# VITE_AUTHORITY_PROXY_TARGET=https://d2j72l2zhhn7o7.cloudfront.net

# Supabase Auth — who checks credentials.
#
# REQUIRED for `pnpm dev` (the real stack), and filled in below: the browser
# authenticates against the shared dev project. Both values are public — the
# anon/publishable key is designed to ship in the client bundle — so they belong
# here rather than in a secret store. `https://localhost:5173/auth/callback` is
# already on that project's redirect allowlist and Google is already enabled.
#
# The only value NOT in a tracked file is the repo-root DATABASE_URL, because it
# carries a password. Get that one from a teammate; see the root .env.example.
#
# FOR `pnpm dev:offline`, DELETE OR COMMENT OUT THE TWO LINES BELOW. That is the
# whole switch, and it is not optional: the client picks Supabase whenever both
# are set (src/app/auth-client.ts), so leaving them here means `pnpm dev:offline`
# signs you in against the real project and then hands the token to the
# in-process dev authority, which does NOT verify it. That combination LOOKS like
# it works while testing nothing, which is why it is worth the one edit. Keep
# VITE_AUTHORITY_BASE_URL=/ above either way.
#
# With both unset, auth is an in-memory stand-in and the app runs fully offline:
# sign-up offers its "email link" on the Check-your-email screen instead of
# sending mail, and Google sign-in is hidden because it cannot work.
VITE_SUPABASE_URL=https://iimihnwlqbsjzemvwupl.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_cDF9B0E48SxbgPEamXHHKg_dgh1iVFE

# AI features (CARS Duel opponent + "Explain it another way" grounded rewrite).
# Optional. Set the key in your untracked apps/learner-web/.env.local, or in the
# repo-root .env.local — Vite's `loadEnv` merges both (see vite.config.ts). It is
# read ONLY server-side (the Vite dev middleware in dev; the learner-API
# `/v1/ai/rewrite` route in prod) and is never exposed to the client bundle.
# Works with any OpenAI-compatible /chat/completions endpoint. With no key set,
# the app still runs: CARS Duel shows an "offline" notice and "Explain it another
# way" falls back to a deterministic re-statement.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# OPTIONAL — override the grounded rewrite route URL. It defaults to the
# same-origin `/v1/ai/rewrite`, which the learner-API serves in prod (behind its
# session authorizer + x-mcat-origin-verify + WAF) and the Vite dev middleware
# serves locally. Set this ONLY to point the browser at a different absolute
# origin. If the route is unreachable/unconfigured, the feature degrades to the
# deterministic fallback.
# VITE_AI_REWRITE_URL=https://d2j72l2zhhn7o7.cloudfront.net/v1/ai/rewrite

# Feature flags (client). Both features below drive dev/preview-only backends
# (the Vite API plugins) and have NO route on the deployed learner API, so both
# default to ON under `vite dev` and OFF in a production build — no override
# needed for normal use. Set an override ONLY to force a value, e.g. to preview
# the prod-gated experience locally, or to switch a feature on for a build once
# its deployed backend exists. Read at build time (see src/app/capabilities.ts).
#
#   VITE_PRACTICE_TEST_ENABLED — the periodic scored practice TEST (runner + the
#     Practice-test card + the /v1/practice-test/summary read). Off in prod until
#     the runner is wired into the deployed backend; see docs/practice-test-prod.md.
#   VITE_DIAGNOSTIC_ENABLED    — the onboarding placement DIAGNOSTIC quiz. Off in
#     prod until the diagnostic engine is wired into the deployed backend; when
#     off, Welcome hides "Take the placement" and onboarding goes straight to plan
#     setup, and /onboarding/diagnostic redirects there too.
# VITE_PRACTICE_TEST_ENABLED=false
# VITE_DIAGNOSTIC_ENABLED=false

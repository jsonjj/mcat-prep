# Learner authority base URL (required — the client throws at boot without it).
#
# LOCAL DEV (default below): "/" keeps API calls same-origin, so the browser is
# never blocked by CORS. Just copy this file:
#   cp apps/learner-web/.env.example apps/learner-web/.env.local
# PRODUCTION build: set an absolute origin instead, e.g.
#   VITE_AUTHORITY_BASE_URL=https://d2j72l2zhhn7o7.cloudfront.net
VITE_AUTHORITY_BASE_URL=/

# Who answers same-origin /v1 in dev (see vite.config.ts). `pnpm dev` and
# `pnpm dev:offline` set the right one for you; these are here for the record:
#   VITE_AUTHORITY_LOCAL     — `pnpm dev`. A local run of the DEPLOYED learner API
#                              (services/local-learner-api) over a real Postgres,
#                              served over HTTPS. Needs the repo-root .env.local
#                              and the Supabase values below. See
#                              docs/runbooks/local-real-stack.md.
#   VITE_AUTHORITY_PROXY_TARGET — proxy /v1 to a deployed authority server-side,
#                              presenting the deployed origin upstream.
#   neither                  — `pnpm dev:offline`. The in-process dev authority,
#                              so the app runs fully offline with no backend.
# VITE_AUTHORITY_PROXY_TARGET=https://d2j72l2zhhn7o7.cloudfront.net

# Supabase Auth — who checks credentials.
#
# REQUIRED for `pnpm dev` (the real stack): the browser authenticates against the
# real project. Both values are public — the anon/publishable key is designed to
# ship in the client bundle — so they belong here rather than in a secret store.
# The shared dev project is filled in below; `https://localhost:5173/auth/callback`
# is already on its redirect allowlist and Google is already enabled.
#
# The only value NOT in a tracked file is the repo-root DATABASE_URL, because it
# carries a password. Get that one from a teammate; see the root .env.example.
#
# UNSET these two and `pnpm dev:offline` uses an in-memory dev stand-in instead,
# so the app runs fully offline with no configuration at all. Sign-up offers its
# "email link" on the Check-your-email screen instead of sending mail, and Google
# sign-in is hidden because it cannot work.
VITE_SUPABASE_URL=https://iimihnwlqbsjzemvwupl.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_cDF9B0E48SxbgPEamXHHKg_dgh1iVFE

# AI features (CARS Duel opponent + "Explain it another way" grounded rewrite).
# Copy to `.env` (untracked) and fill in. The key is read ONLY server-side (the
# Vite dev middleware in dev; the learner-API `/v1/ai/rewrite` route in prod) and
# is never exposed to the client bundle. Works with any OpenAI-compatible
# /chat/completions endpoint. With no key set, the app still runs: CARS Duel
# shows an "offline" notice and "Explain it another way" falls back to a
# deterministic re-statement.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# OPTIONAL — override the grounded rewrite route URL. It defaults to the
# same-origin `/v1/ai/rewrite`, which the learner-API serves in prod (behind its
# session authorizer + x-mcat-origin-verify + WAF) and the Vite dev middleware
# serves locally. Set this ONLY to point the browser at a different absolute
# origin. If the route is unreachable/unconfigured, the feature degrades to the
# deterministic fallback.
# VITE_AI_REWRITE_URL=https://d2j72l2zhhn7o7.cloudfront.net/v1/ai/rewrite

# Keep all package-manager state inside the workspace (sandbox-friendly; no writes to $HOME).
store-dir=.pnpm-store
cache-dir=.pnpm-cache
state-dir=.pnpm-state
# Determinism and safety
engine-strict=false
save-exact=true
# Do not let pnpm self-download the version pinned in package.json#packageManager
# (offline/sandbox friendly; use the pnpm that is already installed).
manage-package-manager-versions=false
# Workspace hygiene
link-workspace-packages=true
prefer-workspace-packages=true
strict-peer-dependencies=false
